<Legislation xmlns="http://www.legislation.gov.uk/namespaces/legislation" DocumentURI="http://www.legislation.gov.uk/uksi/2099/1" RestrictStartDate="2099-01-01">
  <ukm:Metadata xmlns:dc="http://purl.org/dc/elements/1.1/" xmlns:dct="http://purl.org/dc/terms/" xmlns:ukm="http://www.legislation.gov.uk/namespaces/metadata">
    <dc:title>The Invented Safeguards Regulations 2099</dc:title>
    <dct:valid>2099-01-02</dct:valid>
  </ukm:Metadata>
  <Primary>
    <Body>
      <Part>
        <P1group>
          <Title>Invented review duty</Title>
          <P1 id="regulation-1">
            <Pnumber>1</Pnumber>
            <P1para>
              <P2 id="regulation-1-1">
                <Pnumber>1</Pnumber>
                <P2para><Text>An invented operator must keep a register of its widgets.</Text></P2para>
              </P2>
              <P2 id="regulation-1-2">
                <Pnumber>2</Pnumber>
                <P2para>
                  <Text>An invented operator must not release a widget unless</Text>
                  <P3 id="regulation-1-2-a"><Pnumber>a</Pnumber><P3para><Text>it is listed in the register, and</Text></P3para></P3>
                  <P3 id="regulation-1-2-b"><Pnumber>b</Pnumber><P3para><Text>an <CommentaryRef Ref="c1"/>inspector has signed it off.</Text></P3para></P3>
                </P2para>
              </P2>
              <P2 id="regulation-1-3">
                <Pnumber>3</Pnumber>
                <P2para><Text>The inspector may waive paragraph (2)(b) for a spare widget.</Text></P2para>
              </P2>
            </P1para>
          </P1>
        </P1group>
        <P1group>
          <Title>Invented definitions</Title>
          <P1 id="regulation-2">
            <Pnumber>2</Pnumber>
            <P1para><Text>In these Regulations a widget is an invented object.</Text></P1para>
          </P1>
        </P1group>
        <P1group>
          <Title>Invented commencement</Title>
          <P1 id="regulation-9">
            <Pnumber>9</Pnumber>
            <P1para><Text>These Regulations come into force on 1st January 2099.</Text></P1para>
          </P1>
        </P1group>
      </Part>
    </Body>
  </Primary>
</Legislation>
